                  "state": "translated",
                  "value": "%lld home tab without a DriftLoom equivalent (local playlists, feed groups, other services) is skipped."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld home tabs without a DriftLoom equivalent (local playlists, feed groups, other services) are skipped."
                }
