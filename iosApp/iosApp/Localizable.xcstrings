    "An independent fork of NewPipe, licensed under GPL-3.0-or-later. Thanks to the NewPipe contributors.": {
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fork independente do NewPipe, licenciado sob GPL-3.0-or-later. Obrigado aos colaboradores do NewPipe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
