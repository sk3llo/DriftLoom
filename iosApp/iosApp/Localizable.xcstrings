        "pt": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld aba inicial sem equivalente no DriftLoom (playlists locais, grupos do feed, outros serviços) será ignorada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld abas iniciais sem equivalente no DriftLoom (playlists locais, grupos do feed, outros serviços) serão ignoradas."
