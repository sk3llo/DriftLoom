    "%lld channel feeds could not be loaded. Pull to refresh and try again.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld channel feed could not be loaded. Pull to refresh and try again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld channel feeds could not be loaded. Pull to refresh and try again."
                }
              }
            }
          }
        },
        "pt": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Não foi possível carregar %lld feed de canal. Puxe para atualizar e tente de novo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Não foi possível carregar %lld feeds de canais. Puxe para atualizar e tente de novo."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Não foi possível carregar %lld feeds de canais. Puxe para atualizar e tente de novo."
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Не вдалося завантажити %lld стрічки каналів. Потягніть, щоб оновити."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Не вдалося завантажити %lld стрічок каналів. Потягніть, щоб оновити."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Не вдалося завантажити %lld стрічку каналу. Потягніть, щоб оновити."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Не вдалося завантажити %lld стрічок каналів. Потягніть, щоб оновити."
                }
              }
            }
          }
        }
      }
    },
