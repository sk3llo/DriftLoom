    "Back up saved videos, subscriptions, watch history, local playlists, bookmarked playlists, and subscription groups. Downloaded media, playback queues, and app settings are excluded.": {
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça backup de vídeos salvos, inscrições, histórico, playlists locais, playlists favoritas e grupos de inscrições. Mídias baixadas, filas de reprodução e ajustes do app não são incluídos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервна копія збережених відео, підписок, історії переглядів, локальних плейлистів, плейлистів у закладках і груп підписок. Завантажені медіа, черги відтворення та налаштування застосунку не включаються."
          }
