TEAM_ID=
BUNDLE_ID_SUFFIX=$(TEAM_ID)
DRIFTLOOM_APP_GROUP=
DRIFTLOOM_APP_ENTITLEMENTS=
DRIFTLOOM_SHARE_ENTITLEMENTS=

PRODUCT_NAME=DriftLoom
PRODUCT_BUNDLE_IDENTIFIER=net.driftloom.app.DriftLoom$(BUNDLE_ID_SUFFIX)

CURRENT_PROJECT_VERSION=4
MARKETING_VERSION=1.0.3

// Also build a Mac Catalyst app: sandboxed, with the hardened runtime that notarization requires.
SUPPORTS_MACCATALYST=YES
DRIFTLOOM_APP_ENTITLEMENTS[sdk=macosx*]=iosApp/DriftLoom-Mac.entitlements
DRIFTLOOM_SHARE_ENTITLEMENTS[sdk=macosx*]=DriftLoomShare/DriftLoomShare-Mac.entitlements
ENABLE_HARDENED_RUNTIME[sdk=macosx*]=YES
