{
  "sourceLanguage": "en",
  "strings": {
    "Copy link": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar link"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювати посилання"
          }
        }
      }
    },
    "Copy this link, then open DriftLoom and paste it in Search.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie este link, abra o DriftLoom e cole-o na Pesquisa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте це посилання, відкрийте DriftLoom і вставте його в Пошуку."
          }
        }
      }
    },
    "Couldn't save this link. Copy it and paste it in DriftLoom.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar este link. Copie-o e cole-o no DriftLoom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти посилання. Скопіюйте та вставте його в DriftLoom."
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
