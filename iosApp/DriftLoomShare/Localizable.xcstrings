        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Link copied. Open DriftLoom and paste it in Search.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
