{
  "sourceLanguage": "en",
  "strings": {
    "DriftLoom couldn't be opened from here. Copy the link and paste it in DriftLoom.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o DriftLoom daqui. Copie o link e cole no DriftLoom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити DriftLoom звідси. Скопіюйте посилання й вставте його в DriftLoom."
          }
        }
      }
    },
    "Opening in DriftLoom…": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrindo no DriftLoom…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриття в DriftLoom…"
          }
        }
      }
    },
    "Share a YouTube or SoundCloud link to open it in DriftLoom.": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe um link do YouTube ou do SoundCloud para abri-lo no DriftLoom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться посиланням YouTube або SoundCloud, щоб відкрити його в DriftLoom."
          }
        }
      }
    }
  },
  "version": "1.0"
}